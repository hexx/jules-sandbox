{
  "imports": {
    "hono/": "https://deno.land/x/hono/mod.ts",
    "react": "https://esm.sh/react@18",
    "react-dom/client": "https://esm.sh/react-dom@18/client",
    "@tanstack/router": "https://esm.sh/@tanstack/react-router@beta",
    "$std/": "https://deno.land/std@0.220.0/",
    "hono/testing": "https://deno.land/x/hono@v4.0.0-rc.2/testing/index.ts",
    "$std/assert/": "https://deno.land/std@0.220.0/assert/",
    "ai": "https://esm.sh/ai",
    "openai": "https://esm.sh/openai",
    "zod": "https://esm.sh/zod@3",
    "tailwindcss": "https://esm.sh/tailwindcss@3.4.1",
    "lucide-react": "https://esm.sh/lucide-react@0.344.0",
    "tailwindcss-animate": "https://esm.sh/tailwindcss-animate@1.0.7",
    "autoprefixer": "https://esm.sh/autoprefixer@10.4.17",
    "clsx": "https://esm.sh/clsx@2.1.0",
    "tailwind-merge": "https://esm.sh/tailwind-merge@2.2.1",
    "class-variance-authority": "https://esm.sh/class-variance-authority@0.7.0",
    "@radix-ui/react-slot": "https://esm.sh/@radix-ui/react-slot@1.0.2",
    "@radix-ui/react-checkbox": "https://esm.sh/@radix-ui/react-checkbox@1.0.4",
    "@radix-ui/react-label": "https://esm.sh/@radix-ui/react-label@2.0.2",
    "@/lib/utils": "./src/lib/utils.ts",
    "@/components/": "./src/components/"
  },
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-env --allow-net npm:vite",
    "build": "deno run --allow-read --allow-write --allow-env --allow-net npm:vite build",
    "serve": "deno run --allow-read --allow-write --allow-env --allow-net npm:vite preview",
    "start": "deno run --allow-read --allow-net --allow-env src/api/index.ts",
    "test": "deno test --allow-net --allow-env --allow-read src/api/"
  }
}
